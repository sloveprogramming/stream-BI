# ---- 密钥与环境 ----
.env
*.env.local

# ---- Python ----
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
backend/.venv/
# 测试用的项目内临时目录（pytest 的 tmp_path 在本机不可用，见 tests/unit/conftest.py）
backend/tests/.tmp/

# ---- Node ----
node_modules/
frontend/dist/

# ---- 本地工作目录（含记忆/凭据，绝不入库） ----
.workbuddy/
.local/
.superpowers/
.idea/
.vscode/
